{
  "manifest_version": 3,
  "name": "POP Context Adapter",
  "version": "0.2.1",
  "description": "Sends meaningful context from sites you explicitly enable to local POP Core.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["http://127.0.0.1:17831/*"],
  "optional_host_permissions": [
    "https://x.com/*",
    "https://www.google.com/*",
    "https://www.youtube.com/*",
    "https://web.whatsapp.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "POP",
    "default_popup": "popup.html"
  }
}
