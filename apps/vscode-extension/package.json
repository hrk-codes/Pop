{
  "name": "@pop/vscode-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Permission-scoped VS Code context adapter.",
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onCommand:pop.pair",
    "onCommand:pop.sendSelection"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pop.pair",
        "title": "POP: Pair with Desktop"
      },
      {
        "command": "pop.sendSelection",
        "title": "POP: Send Selected Code"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@pop/protocol": "workspace:*",
    "ws": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/vscode": "1.109.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.27.4"
  }
}
