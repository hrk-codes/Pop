{
  "name": "@pop/vscode-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Reserved POP editor adapter; the live-companion release is X-first.",
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onCommand:pop.sendSelection"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pop.sendSelection",
        "title": "POP: Editor Adapter Status"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/vscode": "1.109.0",
    "esbuild": "0.27.4"
  }
}
